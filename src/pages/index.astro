---
import Authors from '@components/pages/Home/Authors.astro'
import Chapters from '@components/pages/Home/Chapters.astro'
import Counters from '@components/pages/Home/Counters.astro'
import Hero from '@components/pages/Home/Hero.astro'
import ProblemStatement from '@components/pages/Home/ProblemStatement.astro'
import TrustedQuote from '@components/pages/Home/TrustQuote.astro'
import WhatsInside from '@components/pages/Home/WhatsInside.astro'
import WhyChoose from '@components/pages/Home/WhyChoose.astro'
import Layout from '../Layout.astro'
import ActionPlan from '@components/pages/Home/ActionPlan.astro'
import Quotes from '@components/pages/Home/Quotes.astro'
import Reviews from '@components/pages/Home/Reviews.astro'
import FreeChapter from '@components/pages/Home/FreeChapter.astro'
import Faq from '@components/pages/Home/Faq.astro'
import Footer from '@components/Footer.astro'
import { DEFAULT_CANONICAL_URL } from '@lib/const'
---

<Layout canonical={`${DEFAULT_CANONICAL_URL}/`}>
  <main id="main-content" tabindex="-1" class="outline-none">
    <Hero />
    <Counters />
    <TrustedQuote />
    <ProblemStatement />
    <Authors />
    <WhatsInside />
    <Chapters />
    <WhyChoose />
    <ActionPlan />
    <Quotes />
    <Reviews />
    <FreeChapter />
    <Faq />
  </main>
  <Footer />
</Layout>
